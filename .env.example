# No .env is required for `npm run simulate`.
# For optional real Tide bootstrap, read docs/TIDE.md before using these settings.
# Copy to ignored .env and edit locally; never put real values in this example.
# Existing .setup/operator.env can take precedence in the bootstrap script.

# Local Docker bootstrap only. No default password; supply a strong secret yourself.
# Never put this credential in client code, adapters, images or recordings.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=


# Licence address and acceptance must come from the deployment owner.
# Read https://tide.org/legal; set acceptance to yes only if you personally agree.
# Leave both empty if you are only running simulation.
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# Real mode: genuine server-only adapter alternative to data/tidecloak.json.
# Never invent keys or include bootstrap secrets. Browser adapter is separate.
# CLIENT_ADAPTER={"realm":"...","auth-server-url":"...","resource":"...","jwk":{...}}

# Optional runtime settings (uncomment only when needed).
# SIMULATION_DATA_DIR=./data/rehearsal-01
# VAULT_DB_PATH=./data/vault.sqlite
# APP_ORIGIN=http://localhost:3000
